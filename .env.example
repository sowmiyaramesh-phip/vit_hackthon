# ==============================================================================
# ATLAS+MONITORING Environment Configuration
# ==============================================================================

# Database Configuration (MySQL)
# Set USE_MYSQL=true when MySQL service is running locally
USE_MYSQL=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=atlas_monitoring

# Flask Server Port
PORT=5000
FLASK_ENV=development
